{
  "name": "jjsewnvac-prototype",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "J & J Sew N Vac website redesign prototype by Business Web Express",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "images": "python scripts/fetch-images.py",
    "deploy:staging": "npm run build && npx wrangler@4.121.0 deploy --env staging",
    "deploy": "npm run build && npx wrangler@4.121.0 deploy"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  }
}
